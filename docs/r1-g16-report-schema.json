{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ligature-workspace/docs/r1-g16-report-schema.json",
  "title": "R1/G16 reconciliation report — v1.0",
  "description": "Machine-readable gate-r1-g16 --json output (chainlink #160). Gate acceptance, source resolution, and interaction reconciliation are separate. C_static discovery remains a syntactic lower bound; undeclared warnings do not count as checked.",
  "type": "object",
  "required": ["format", "exit_code", "gate_acceptance", "summary", "reports", "findings"],
  "additionalProperties": false,
  "properties": {
    "format": { "type": "string", "const": "ligature.r1-g16-report.v1" },
    "exit_code": { "type": "integer", "enum": [0, 1, 3] },
    "gate_acceptance": { "type": "string", "enum": ["accepted", "blocked", "decision-required"] },
    "summary": { "$ref": "#/$defs/summary" },
    "reports": { "type": "array", "items": { "$ref": "#/$defs/report" } },
    "findings": { "type": "array", "items": { "$ref": "#/$defs/finding" } }
  },
  "$defs": {
    "counts": {
      "type": "object",
      "required": ["reports", "discovered", "checked", "unresolved", "undeclared_warnings", "undeclared_blocking", "configuration_mismatches"],
      "additionalProperties": false,
      "properties": {
        "reports": { "type": "integer", "minimum": 0 },
        "discovered": { "type": "integer", "minimum": 0 },
        "checked": { "type": "integer", "minimum": 0 },
        "unresolved": { "type": "integer", "minimum": 0 },
        "undeclared_warnings": { "type": "integer", "minimum": 0 },
        "undeclared_blocking": { "type": "integer", "minimum": 0 },
        "configuration_mismatches": { "type": "integer", "minimum": 0 }
      }
    },
    "state": {
      "type": "string",
      "enum": ["not-evaluated", "no-discovered-calls", "complete", "incomplete"]
    },
    "summary": {
      "type": "object",
      "required": ["counts", "source_resolution", "interaction_reconciliation", "discovery_completeness"],
      "additionalProperties": false,
      "properties": {
        "counts": { "$ref": "#/$defs/counts" },
        "source_resolution": { "$ref": "#/$defs/state" },
        "interaction_reconciliation": { "$ref": "#/$defs/state" },
        "discovery_completeness": { "type": "string", "const": "syntactic-lower-bound" }
      }
    },
    "report": {
      "type": "object",
      "required": ["report_path", "crate_dir", "counts", "source_resolution", "interaction_reconciliation"],
      "additionalProperties": false,
      "properties": {
        "report_path": { "type": "string", "minLength": 1 },
        "crate_dir": { "type": "string", "minLength": 1 },
        "counts": { "$ref": "#/$defs/counts" },
        "source_resolution": { "$ref": "#/$defs/state" },
        "interaction_reconciliation": { "$ref": "#/$defs/state" }
      }
    },
    "finding": {
      "type": "object",
      "required": ["gate", "path", "reason", "severity"],
      "additionalProperties": false,
      "properties": {
        "gate": { "type": "string", "enum": ["R1", "G16"] },
        "path": { "type": "string" },
        "reason": { "type": "string" },
        "severity": { "type": "string", "enum": ["error", "decision", "warn", "info"] }
      }
    }
  }
}
